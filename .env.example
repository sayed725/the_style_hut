# Neon PostgreSQL Connection String
# Get this from your Neon Console (https://console.neon.tech) -> Connection Details
DATABASE_URL=postgresql://username:password@ep-your-project-pooler.c-4.aws.neon.tech/neondb?sslmode=verify-full

# Server Port and Host
PORT=3000
HOST=127.0.0.1

# Time Zone and Week Start (0=Sun, 6=Sat)
STORE_TZ=Asia/Dhaka
WEEK_START=6

# Set to 1 if running behind an HTTPS proxy (e.g. Render, Railway, Cloudflare)
# COOKIE_SECURE=1
# TRUST_PROXY=1
